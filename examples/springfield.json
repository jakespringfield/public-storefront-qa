{
  "domain": "springfield-systems.jakespringfield1.workers.dev",
  "timeout_seconds": 10,
  "max_response_bytes": 500000,
  "scheduled_evidence_minimum_hours": 72,
  "urls": [
    {
      "id": "storefront",
      "url": "https://springfield-systems.jakespringfield1.workers.dev/public-storefront-qa"
    }
  ],
  "checks": [
    {
      "id": "storefront-status",
      "url": "storefront",
      "type": "status",
      "expected": 200
    },
    {
      "id": "storefront-title",
      "url": "storefront",
      "type": "title",
      "expected": "Public Storefront QA Managed Pilot | Springfield Systems"
    },
    {
      "id": "storefront-canonical",
      "url": "storefront",
      "type": "canonical",
      "expected": "https://springfield-systems.jakespringfield1.workers.dev/public-storefront-qa"
    },
    {
      "id": "storefront-indexability",
      "url": "storefront",
      "type": "robots-indexability",
      "expected": "indexable"
    },
    {
      "id": "storefront-structured-data",
      "url": "storefront",
      "type": "structured-data-presence",
      "expected": "present"
    },
    {
      "id": "storefront-primary-copy",
      "url": "storefront",
      "type": "text",
      "value": "Request the non-binding $250 pilot scope review",
      "expected": "present"
    },
    {
      "id": "storefront-main-selector",
      "url": "storefront",
      "type": "selector",
      "value": "main#storefront-main",
      "expected": "present"
    },
    {
      "id": "storefront-home-reference",
      "url": "storefront",
      "type": "asset-reference",
      "value": "https://springfield-systems.jakespringfield1.workers.dev/",
      "expected": "present"
    }
  ]
}
